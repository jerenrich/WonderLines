{
  "name": "coloring-sheets-api",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "triggers": {"crons": ["37 * * * *"]},
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "images": { "binding": "IMAGES" },
  "ai": { "binding": "AI" },
  "ratelimits": [{"name": "REGISTRATION_LIMITER", "namespace_id": "1005", "simple": {"limit": 5, "period": 60}}],
  "vars": {
    "MODERATION_MODEL": "clef",
    "FREE_DAILY_ALLOWANCE": "100",
    "COMPARISON_ACCOUNT_ID": "f66c3047-7ae6-4a1d-9144-7514e7a44961",
    "AI_GATEWAY_ID": "coloring-sheets",
    "MODERATION_GATEWAY_ID": "coloring-sheets"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ACCOUNTS", "class_name": "Account" },
      { "name": "BUDGET", "class_name": "Budget" },
      { "name": "COMPARISON_RUNNERS", "class_name": "ComparisonImageRunner" }
    ]
  },
  "migrations": [
    { "tag": "v1-anonymous-accounts", "new_sqlite_classes": ["Account", "Budget"] },
    { "tag": "v2-comparison-image-runners", "new_sqlite_classes": ["ComparisonImageRunner"] }
  ],
  "r2_buckets": [
    { "binding": "GENERATIONS", "bucket_name": "coloring-sheets-generations" }
  ],
  "secrets": {
    // Provider secrets are conditional: OPENAI_API_KEY / GOOGLE_AI_STUDIO_API_KEY
    // for Worker-held keys; AI_GATEWAY_TOKEN when routing through AI Gateway.
    // Redmond and Z-Image Turbo via fal share FAL_KEY and FAL_DAILY_GENERATION_LIMIT.
    // Workers AI models additionally require a distinct WORKERS_AI_API_TOKEN.
    // Gateway and model settings are dashboard-managed; deploy with --keep-vars.
    // MODERATION_STRATEGY=parallel additionally requires TYPESAFE_API_KEY,
    // evaluated profiles and the client's revised AI-sharing notice (version 2).
    "required": ["ACCOUNT_TOKEN_SECRET"]
  }
}
